# Copy to .env (git-ignored) and fill in ONE credential.
# docker compose reads .env automatically; run `docker compose up -d` again after editing.

# Claude Pro/Max subscription: run `claude setup-token` on the host and paste the token.
CLAUDE_CODE_OAUTH_TOKEN=

# Or an Anthropic API key (billed per token).
ANTHROPIC_API_KEY=

# --- Custom endpoint (optional) -------------------------------------------
# Send Claude Code's API requests to another Anthropic-compatible endpoint
# (an LLM gateway, a proxy, a corporate relay). Everything Claude Code sends,
# including your profile and the postings, goes to this server: use only one you trust.
# A server running on this machine is reachable from the container as
# host.docker.internal, not localhost, e.g. http://host.docker.internal:8080
# ANTHROPIC_BASE_URL=
# Bearer token for that endpoint, if it wants one instead of ANTHROPIC_API_KEY.
# ANTHROPIC_AUTH_TOKEN=
# Model name, if the endpoint names models differently.
# ANTHROPIC_MODEL=

# Host port for the web UI (http://localhost:3000).
WEB_PORT=3000

# The web UI's "skip every check" permission mode (bypassPermissions) is offered
# only inside Docker. Set this to 1 to allow it when running the server directly
# on your machine, where the AI could then touch files outside this repo unasked.
# AJS_ALLOW_BYPASS=1

# Saramin Open API key, once issued (optional).
# SARAMIN_API_TOKEN=
